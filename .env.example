# Bu dosyayı .env olarak kopyalayıp doldurun.

# Canlı sitede PostgreSQL bağlantı adresi (ör. Neon, Supabase veya kendi sunucunuz).
# Vercel'de Neon bağlanınca DATABASE_URL (ve POSTGRES_URL) otomatik eklenir.
# Boş bırakırsanız site, bilgisayarınızda .veri/ klasöründe gömülü bir veritabanı (PGlite) kullanır
# ve ilk açılışta örnek ürünleri yükler.
DATABASE_URL=

# Sitenin tam adresi (e-postalardaki bağlantılar için). Vercel'de boş bırakın; proje adresi otomatik bulunur.
SITE_URL=http://localhost:3000

# Ödeme altyapısı: "test" (gerçek para çekilmez). iyzico / PayTR bağlantısı sonraki aşamada eklenecek.
ODEME_SAGLAYICI=test

# Canlı sunucuda /yonetim/kurulum sayfasında ilk yönetici hesabını açmak için istenen gizli anahtar.
# Uzun, tahmin edilemez bir değer yazın. Kendi bilgisayarınızda (npm run dev) gerekmez.
KURULUM_ANAHTARI=

# E-posta gönderimi (SMTP). Boş bırakırsanız e-postalar gönderilmez, sunucu konsoluna yazılır.
# Örnek: alan adınızın e-postası, Yandex 360 / Google Workspace ya da Brevo gibi bir servis.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Müşterinin göreceği gönderen, ör: Lavinia House <siparis@laviniahouse.com>
EPOSTA_GONDEREN=
# Yeni sipariş / teklif bildirimleri buraya gelir. Boşsa panel Ayarlar'daki e-posta kullanılır.
MAGAZA_EPOSTA=

# --- Vercel ---
# Vercel Blob dosya deposu bağlanınca BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID otomatik eklenir.
# Blob deposunun erişim türü: private ya da public. Boşsa ilk yüklemede otomatik bulunur.
BLOB_ERISIM=
# Canlı veritabanı ilk kez açıldığında örnek ürünler de yüklensin mi? (1 = evet). Boşsa yalnızca
# mağaza ayarları, kategoriler ve malzemeler yüklenir.
ORNEK_VERI=
